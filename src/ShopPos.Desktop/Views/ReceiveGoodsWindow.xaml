<Window x:Class="ShopPos.Desktop.Views.ReceiveGoodsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="1120" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"/>

        <!-- delivery details -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Supplier's invoice number" Margin="0,0,0,4"/>
                <TextBox Text="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Date received" Margin="0,0,0,4"/>
                <DatePicker SelectedDate="{Binding ReceivedDate}" Padding="4"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Notes" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
            </StackPanel>
        </Grid>

        <!-- adding items (only when there is no purchase order) -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0"
                    Visibility="{Binding IsDirect, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <TextBox DockPanel.Dock="Right" Width="60" Padding="6" Margin="8,0,0,0" ToolTip="Quantity"
                         Text="{Binding ItemQtyText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Padding="6" ToolTip="Type or scan an item (name, SKU or barcode) and press Enter"
                         Text="{Binding ItemSearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SubmitItemCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding ItemResults}" MaxHeight="130">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button HorizontalContentAlignment="Stretch" Padding="8,4" Background="White"
                                Command="{Binding DataContext.PickItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- what arrived -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Lines}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  SelectionMode="Single" Margin="0,12,0,0" RowHeight="34">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Item" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Ordered" Binding="{Binding OrderedText}" IsReadOnly="True" Width="130"/>

                <DataGridTemplateColumn Header="Arrived now" Width="95">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Unit cost" Width="95">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding CostText, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Batch no" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding BatchNo, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Visibility="{Binding IsBatch, Converter={StaticResource BoolToVis}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Expiry" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding ExpiryDate}"
                                        Visibility="{Binding IsBatch, Converter={StaticResource BoolToVis}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="IMEIs" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding SerialButtonText}" Click="Serials_Click" Margin="2"
                                    Visibility="{Binding IsSerial, Converter={StaticResource BoolToVis}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N2}" IsReadOnly="True" Width="95"/>

                <DataGridTemplateColumn Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Remove" Margin="2"
                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding DataContext.IsDirect, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- money and buttons -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding TotalText}" FontSize="18" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Pay now" Margin="0,0,0,4"/>
                        <TextBox Width="120" Padding="6" Text="{Binding PaidText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Paid with" Margin="0,0,0,4"/>
                        <ComboBox Width="150" Padding="6" ItemsSource="{Binding Methods}"
                                  SelectedItem="{Binding SelectedMethod}" DisplayMemberPath="Name"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Reference" Margin="0,0,0,4"/>
                        <TextBox Width="200" Padding="6" Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding DueText}" Foreground="#92400E" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                <Button Content="Cancel" IsCancel="True" Padding="22,10" Margin="0,0,8,0"/>
                <Button Content="Save delivery" IsDefault="True" Padding="26,10" Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
