<UserControl x:Class="ShopPos.Desktop.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: search + list -->
        <DockPanel Grid.Column="0" Margin="0,0,24,0">
            <TextBlock DockPanel.Dock="Top" Text="Products" FontSize="24"
                       FontWeight="SemiBold" Margin="0,0,0,12"/>
            <Button DockPanel.Dock="Top" Content="+ New product" Command="{Binding NewProductCommand}"
                    HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,8"/>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchCommand}"
                        Padding="10,4" Margin="6,0,0,0"/>
                <TextBox Padding="6" ToolTip="Type a name, SKU or scan a barcode, then press Enter"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>

            <ListBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Subtitle}" Foreground="#666" FontSize="12"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Right: form -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}" FontSize="18" FontWeight="SemiBold"/>

                <WrapPanel Margin="0,12,0,0">
                    <StackPanel Width="300" Margin="0,0,16,12">
                        <TextBlock Text="Product name *" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                    </StackPanel>
                    <StackPanel Width="220" Margin="0,0,16,12">
                        <TextBlock Text="Category" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}"
                                  DisplayMemberPath="Name" Padding="6"/>
                    </StackPanel>
                    <StackPanel Width="140" Margin="0,0,16,12">
                        <TextBlock Text="Type" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ProductTypes}" SelectedItem="{Binding ProductType}" Padding="6"/>
                    </StackPanel>
                    <StackPanel Width="220" Margin="0,0,16,12">
                        <TextBlock Text="Brand" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                    </StackPanel>
                </WrapPanel>

                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Track IMEI / serial number" IsChecked="{Binding TracksSerial}"
                              IsEnabled="{Binding IsStock}" Margin="0,0,24,0"/>
                    <CheckBox Content="Track batch / expiry date" IsChecked="{Binding TracksBatch}"
                              IsEnabled="{Binding IsStock}" Margin="0,0,24,0"/>
                    <CheckBox Content="Active" IsChecked="{Binding IsActive}"/>
                </StackPanel>

                <DockPanel Margin="0,20,0,0">
                    <Button DockPanel.Dock="Right" Content="+ Add variant" Command="{Binding AddVariantCommand}"
                            Padding="12,4"/>
                    <TextBlock Text="Variants (size, colour, model...) and prices" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <DataGrid ItemsSource="{Binding Variants}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                          SelectionMode="Single" MinHeight="140" Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Variant (e.g. Black / 128GB)"
                                            Binding="{Binding VariantName}" Width="*"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100"/>
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="130"/>
                        <DataGridTemplateColumn Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Generate"
                                            Command="{Binding DataContext.GenerateBarcodeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Cost" Binding="{Binding CostPrice, StringFormat=N2}" Width="80"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding SellingPrice, StringFormat=N2}" Width="80"/>
                        <DataGridTextColumn Header="Reorder at" Binding="{Binding ReorderLevel, StringFormat=0.###}" Width="80"/>
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="55"/>
                        <DataGridTemplateColumn Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remove"
                                            Command="{Binding DataContext.RemoveVariantCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Leave SKU empty to auto-generate. Stock items without a barcode get an internal one when saved."
                           Foreground="#666" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock Text="{Binding InfoMessage}" Foreground="#15803D" TextWrapping="Wrap" Margin="0,12,0,0"/>

                <Button Content="Save product" Command="{Binding SaveCommand}" HorizontalAlignment="Left"
                        Padding="28,8" Margin="0,16,0,24"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
