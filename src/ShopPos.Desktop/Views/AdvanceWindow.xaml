<Window x:Class="ShopPos.Desktop.Views.AdvanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advance payment" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="Advance payment" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Foreground="#555" Margin="0,2,0,0">
            <Run Text="Repair job "/><Run Text="{Binding JobNo, Mode=OneWay}"/>
        </TextBlock>

        <TextBlock Text="Payment method" Margin="0,16,0,4"/>
        <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}"
                  DisplayMemberPath="Name" Padding="6"/>

        <TextBlock Text="Amount" Margin="0,12,0,4"/>
        <TextBox x:Name="AmountBox" FontSize="18" Padding="6"
                 Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Reference (optional, for example a bKash transaction ID)" Margin="0,12,0,4"/>
        <TextBox Padding="6" Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="22,9" Margin="0,0,8,0"/>
            <Button Content="Record advance" IsDefault="True" Padding="26,9" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
