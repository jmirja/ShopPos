<Window x:Class="ShopPos.Desktop.Views.VoidSaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Void a sale" Width="640" Height="680" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Void a sale" FontSize="22" FontWeight="SemiBold"/>

        <DockPanel Grid.Row="1" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Find" Padding="20,7" Margin="8,0,0,0" Click="Find_Click"/>
            <TextBox x:Name="InvoiceBox" FontSize="16" Padding="8" ToolTip="Invoice number from the receipt"
                     Text="{Binding InvoiceText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="InvoiceBox_KeyDown"/>
        </DockPanel>


        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Top" DataContext="{Binding Found}">
                <TextBlock FontSize="16" FontWeight="SemiBold">
                    <Run Text="{Binding InvoiceNo, Mode=OneWay}"/>
                    <Run Text="  -  "/>
                    <Run Text="{Binding DateText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Foreground="#555" Margin="0,2,0,0">
                    <Run Text="Cashier: "/><Run Text="{Binding Cashier, Mode=OneWay}"/>
                    <Run Text="   Customer: "/><Run Text="{Binding Customer, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Margin="0,2,0,8">
                    <Run Text="Total "/><Run Text="{Binding Total, StringFormat=N2, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text="   Paid "/><Run Text="{Binding Paid, StringFormat=N2, Mode=OneWay}"/>
                    <Run Text="   Due "/><Run Text="{Binding Due, StringFormat=N2, Mode=OneWay}"/>
                    <Run Text="   Status "/><Run Text="{Binding Status, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Found.Lines}" IsReadOnly="True" AutoGenerateColumns="False"
                      CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Item" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Qty, StringFormat=0.###}" Width="60"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N2}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="Reason for voiding (required)" Margin="0,0,0,4"/>
            <TextBox Padding="6" Text="{Binding ReasonText, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanVoidNow}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock Text="{Binding InfoMessage}" Foreground="#15803D" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Close" IsCancel="True" Padding="22,8" Margin="0,0,8,0"/>
            <Button Content="Void this sale" Padding="24,8" Click="Void_Click" IsEnabled="{Binding CanVoidNow}"/>
        </StackPanel>
    </Grid>
</Window>
