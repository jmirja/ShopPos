<Window x:Class="ShopPos.Desktop.Views.RepairDeliveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deliver device" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="Hand the device over" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Foreground="#555" Margin="0,2,0,0">
            <Run Text="{Binding JobNo, Mode=OneWay}"/><Run Text="  -  "/><Run Text="{Binding Device, Mode=OneWay}"/>
        </TextBlock>

        <TextBlock Text="Labour charge (your work, without the parts)" Margin="0,16,0,4"/>
        <TextBox x:Name="LabourBox" FontSize="18" Padding="6"
                 Text="{Binding LabourText, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Warranty (days)" Margin="0,12,0,4"/>
        <TextBox Padding="6" Text="{Binding WarrantyText, UpdateSourceTrigger=PropertyChanged}"/>

        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6"
                Padding="14" Margin="0,16,0,0">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PartsTotal, StringFormat=N2}"/>
                    <TextBlock Text="Spare parts"/>
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat=N2}"
                               FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Total bill" FontWeight="SemiBold"/>
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Advance, StringFormat=N2}"/>
                    <TextBlock Text="Advance already paid"/>
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Balance, StringFormat=N2}"
                               FontSize="18" FontWeight="Bold" Foreground="#92400E"/>
                    <TextBlock Text="Still to pay" FontWeight="SemiBold"/>
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Refund, StringFormat=N2}"/>
                    <TextBlock Text="Advance to give back (it was more than the bill)"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="22,9" Margin="0,0,8,0"/>
            <Button Content="Continue" IsDefault="True" Padding="26,9" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
