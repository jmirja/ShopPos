<Window x:Class="ShopPos.Desktop.Views.ShiftCloseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Close shift" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="Close shift" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Foreground="#666" Margin="0,4,0,0">
            <Run Text="Opened "/><Run Text="{Binding Summary.OpenedAtText, Mode=OneWay}"/>
        </TextBlock>

        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6"
                Padding="14" Margin="0,14,0,0">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary.SalesTotal, StringFormat=N2, Mode=OneWay}"/>
                    <TextBlock>
                        <Run Text="Sales ("/><Run Text="{Binding Summary.SalesCount, Mode=OneWay}"/><Run Text=")"/>
                    </TextBlock>
                </DockPanel>

                <TextBlock Text="Received / refunded by payment method" Foreground="#666" FontSize="12" Margin="0,10,0,4"/>
                <ItemsControl ItemsSource="{Binding Summary.Methods}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <TextBlock DockPanel.Dock="Right">
                                    <Run Text="{Binding In, StringFormat=N2, Mode=OneWay}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding Out, StringFormat=N2, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Method}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Margin="0,10"/>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary.OpeningCash, StringFormat=N2, Mode=OneWay}"/>
                    <TextBlock Text="Opening cash"/>
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary.CashIn, StringFormat=N2, Mode=OneWay}"/>
                    <TextBlock Text="+ Cash received"/>
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary.CashOut, StringFormat=N2, Mode=OneWay}"/>
                    <TextBlock Text="- Cash refunded"/>
                </DockPanel>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Summary.ExpectedCash, StringFormat=N2, Mode=OneWay}"
                               FontWeight="Bold" FontSize="18"/>
                    <TextBlock Text="Cash that should be in the drawer" FontWeight="SemiBold"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="Cash you counted in the drawer" Margin="0,16,0,4"/>
        <TextBox x:Name="CountedBox" FontSize="18" Padding="8"
                 Text="{Binding CountedText, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="{Binding DifferenceText}" FontWeight="SemiBold" Foreground="#B45309" Margin="0,6,0,0"/>

        <TextBlock Text="Note (optional)" Margin="0,12,0,4"/>
        <TextBox Padding="6" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="22,9" Margin="0,0,8,0"/>
            <Button Content="Close shift" IsDefault="True" Padding="26,9" Click="CloseButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
