<Window x:Class="ShopPos.Desktop.Views.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="900" Height="720" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="Receipt" FontSize="20" FontWeight="SemiBold"/>

            <TextBlock Text="Paper" Margin="0,16,0,4"/>
            <ComboBox ItemsSource="{Binding Papers}" SelectedItem="{Binding SelectedPaper}"
                      DisplayMemberPath="Label" Padding="6"/>
            <CheckBox Content="Use this paper from now on" IsChecked="{Binding RememberPaper}" Margin="0,10,0,0"/>

            <Button Content="Print..." Command="{Binding PrintCommand}" IsDefault="True"
                    Padding="0,10" FontSize="15" Margin="0,18,0,0"/>
            <Button Content="Close" IsCancel="True" Padding="0,8" Margin="0,8,0,0"/>

            <TextBlock Text="{Binding Message}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,14,0,0"/>

            <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="12" Margin="0,18,0,0"
                       Text="In the Windows print window choose your receipt printer. If the receipt is cut off or too small, open Preferences and set the paper size to your roll width and the scale to 100%."/>
        </StackPanel>

        <DocumentViewer Grid.Column="1" Document="{Binding Document, Mode=OneWay}"/>
    </Grid>
</Window>
