<Window x:Class="ShopPos.Desktop.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payment" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="Payment" FontSize="22" FontWeight="SemiBold"/>

        <TextBlock Text="Total to pay" Foreground="#666" Margin="0,12,0,0"/>
        <TextBlock Text="{Binding Total, StringFormat=N2}" FontSize="36" FontWeight="Bold"/>

        <TextBlock Margin="0,16,0,6" Foreground="#666" FontSize="12"
                   Text="Type what the customer pays with each method. For cash type the money handed over; the change is worked out for you."/>

        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="15" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" FontSize="15" Padding="6" HorizontalContentAlignment="Right"
                                 Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Grid.Column="2" Padding="6" Margin="8,0,0,0"
                                 ToolTip="Reference / transaction ID (optional)"
                                 Text="{Binding ReferenceText, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding ShowReference, Converter={StaticResource BoolToVis}}"/>
                        <Button Grid.Column="3" Content="Fill" Padding="10,4" Margin="8,0,0,0"
                                ToolTip="Put the amount that is still missing here"
                                Command="{Binding DataContext.FillRemainingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6"
                Padding="14" Margin="0,8,0,0">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Paid, StringFormat=N2}" FontSize="15"/>
                    <TextBlock Text="Paid" FontSize="15"/>
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Change, StringFormat=N2}"
                               FontSize="22" FontWeight="Bold" Foreground="#15803D"/>
                    <TextBlock Text="Change to give" FontSize="15" VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Due, StringFormat=N2}"
                               FontSize="15" FontWeight="SemiBold" Foreground="#B45309"/>
                    <TextBlock Text="Still due" FontSize="15"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding Error}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="22,9" Margin="0,0,8,0"/>
            <Button x:Name="ConfirmButton" Content="Confirm sale" IsDefault="True" Padding="26,9"
                    IsEnabled="{Binding CanConfirm}" Click="ConfirmButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
