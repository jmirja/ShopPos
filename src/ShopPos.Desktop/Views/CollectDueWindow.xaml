<Window x:Class="ShopPos.Desktop.Views.CollectDueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Collect payment" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="Collect payment" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding CustomerName}" FontSize="15" Foreground="#555" Margin="0,2,0,0"/>

        <Border Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="6"
                Padding="12" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding TotalDue, StringFormat=N2}"
                           FontSize="22" FontWeight="Bold" Foreground="#92400E"/>
                <TextBlock Text="Total owed" VerticalAlignment="Center" FontSize="15"/>
            </DockPanel>
        </Border>

        <TextBlock Text="Unpaid bills (the oldest is paid first)" FontWeight="SemiBold" Margin="0,14,0,6"/>
        <DataGrid ItemsSource="{Binding OpenSales}" IsReadOnly="True" AutoGenerateColumns="False"
                  CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="170">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="100"/>
                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNo}" Width="*"/>
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="80"/>
                <DataGridTextColumn Header="Still due" Binding="{Binding Due, StringFormat=N2}" Width="85"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Margin="0,6,0,0" Foreground="#666" FontSize="12">
            <Run Text="Old balance from before the app: "/>
            <Run Text="{Binding OpeningRemaining, StringFormat=N2, Mode=OneWay}"/>
        </TextBlock>

        <TextBlock Text="Payment method" Margin="0,14,0,4"/>
        <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}"
                  DisplayMemberPath="Name" Padding="6"/>

        <TextBlock Text="Amount" Margin="0,12,0,4"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Full amount" Command="{Binding FillFullCommand}"
                    Padding="12,6" Margin="8,0,0,0"/>
            <TextBox x:Name="AmountBox" FontSize="18" Padding="6"
                     Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <TextBlock Text="Reference (optional, for example a bKash transaction ID)" Margin="0,12,0,4"/>
        <TextBox Padding="6" Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="22,9" Margin="0,0,8,0"/>
            <Button Content="Record payment" IsDefault="True" Padding="26,9" Click="Confirm_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
