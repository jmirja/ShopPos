<UserControl x:Class="ShopPos.Desktop.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <!-- Left: stock list -->
        <DockPanel Grid.Column="0" Margin="0,0,24,0">
            <TextBlock DockPanel.Dock="Top" Text="Stock" FontSize="24"
                       FontWeight="SemiBold" Margin="0,0,0,12"/>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}"
                        Padding="10,4" Margin="6,0,0,0"/>
                <CheckBox DockPanel.Dock="Right" Content="Low stock only" IsChecked="{Binding LowOnly}"
                          VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBox Padding="6" ToolTip="Type a name, SKU or scan a barcode, then press Enter"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding RefreshCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>

            <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Foreground="#B45309"
                       FontWeight="SemiBold" Margin="0,0,0,8"/>

            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                      IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                      SelectionMode="Single" HeadersVisibility="Column">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLow}" Value="True">
                                <Setter Property="Background" Value="#FEF3C7"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Item" Binding="{Binding DisplayName}" Width="*"/>
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="100"/>
                    <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120"/>
                    <DataGridTextColumn Header="On hand" Binding="{Binding QtyOnHand, StringFormat=0.###}" Width="70"/>
                    <DataGridTextColumn Header="Reorder at" Binding="{Binding ReorderLevel, StringFormat=0.###}" Width="80"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="Tracking" Binding="{Binding Tracking}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Right: actions + history -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Stock actions" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedTitle}" TextWrapping="Wrap" Margin="0,8,0,0"/>

                <!-- ===== Quantity-only items ===== -->
                <StackPanel Visibility="{Binding IsPlainMode, Converter={StaticResource BoolToVis}}"
                            Margin="0,12,0,0">
                    <TextBlock Text="What happened?" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding ActionOptions}" SelectedItem="{Binding SelectedAction}"
                              DisplayMemberPath="Label" Padding="6"/>

                    <TextBlock Text="Quantity" Margin="0,12,0,4"/>
                    <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>

                    <TextBlock Text="Note (optional)" Margin="0,12,0,4"/>
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>

                    <Button Content="Apply" Command="{Binding ApplyCommand}" HorizontalAlignment="Left"
                            Padding="28,8" Margin="0,16,0,0"/>
                </StackPanel>

                <!-- ===== IMEI / serial items ===== -->
                <StackPanel Visibility="{Binding IsSerialMode, Converter={StaticResource BoolToVis}}"
                            Margin="0,12,0,0">
                    <TextBlock Text="Add IMEI / serial numbers" FontWeight="SemiBold"/>
                    <TextBlock Text="One per line, or scan them one after another. A 15-digit IMEI is checked for typing mistakes."
                               Foreground="#666" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8"/>

                    <ComboBox ItemsSource="{Binding ReceiveOptions}" SelectedItem="{Binding SelectedReceive}"
                              DisplayMemberPath="Label" Padding="6"/>

                    <TextBox Text="{Binding SerialInput, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             MinHeight="110" MaxHeight="200" Padding="6" Margin="0,8,0,0"/>

                    <TextBlock Text="Note (optional, required when removing)" Margin="0,10,0,4"/>
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>

                    <Button Content="Add to stock" Command="{Binding AddSerialsCommand}"
                            HorizontalAlignment="Left" Padding="28,8" Margin="0,12,0,0"/>

                    <TextBlock Text="Numbers in stock" FontWeight="SemiBold" Margin="0,20,0,6"/>
                    <CheckBox Content="Show sold / removed too" IsChecked="{Binding ShowAllSerials}"
                              Margin="0,0,0,6"/>
                    <DataGrid ItemsSource="{Binding Serials}" SelectedItem="{Binding SelectedSerial}"
                              IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" MaxHeight="240">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IMEI / serial" Binding="{Binding SerialNo}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="Added" Binding="{Binding Added}" Width="95"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Content="Remove selected number (write the reason in Note)"
                            Command="{Binding RemoveSerialCommand}" HorizontalAlignment="Left"
                            Padding="12,6" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- ===== Batch / expiry items ===== -->
                <StackPanel Visibility="{Binding IsBatchMode, Converter={StaticResource BoolToVis}}"
                            Margin="0,12,0,0">
                    <TextBlock Text="Add batch stock" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <ComboBox ItemsSource="{Binding ReceiveOptions}" SelectedItem="{Binding SelectedReceive}"
                              DisplayMemberPath="Label" Padding="6"/>

                    <TextBlock Text="Batch number *" Margin="0,10,0,4"/>
                    <TextBox Text="{Binding BatchNo, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>

                    <TextBlock Text="Expiry date" Margin="0,10,0,4"/>
                    <DatePicker SelectedDate="{Binding ExpiryDate}" Padding="4"/>

                    <TextBlock Text="Quantity *" Margin="0,10,0,4"/>
                    <TextBox Text="{Binding BatchQtyText, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>

                    <TextBlock Text="Note (optional)" Margin="0,10,0,4"/>
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>

                    <Button Content="Add batch" Command="{Binding AddBatchCommand}"
                            HorizontalAlignment="Left" Padding="28,8" Margin="0,12,0,0"/>

                    <TextBlock Text="Batches in stock (earliest expiry first)" FontWeight="SemiBold"
                               Margin="0,20,0,6"/>
                    <DataGrid ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}"
                              IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Batch" Binding="{Binding BatchNo}" Width="*"/>
                            <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryText}" Width="95"/>
                            <DataGridTextColumn Header="On hand" Binding="{Binding QtyOnHand, StringFormat=0.###}" Width="65"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Remove from the selected batch" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <DockPanel>
                        <TextBox DockPanel.Dock="Left" Width="70" Padding="6"
                                 Text="{Binding RemoveQtyText, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox ItemsSource="{Binding RemoveReasons}" SelectedItem="{Binding RemoveReason}"
                                  Padding="6" Margin="8,0,0,0"/>
                    </DockPanel>
                    <Button Content="Remove" Command="{Binding RemoveBatchCommand}"
                            HorizontalAlignment="Left" Padding="20,6" Margin="0,8,0,0"/>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock Text="{Binding InfoMessage}" Foreground="#15803D" TextWrapping="Wrap" Margin="0,12,0,0"/>

                <TextBlock Text="Recent movements" FontWeight="SemiBold" Margin="0,24,0,6"/>
                <DataGrid ItemsSource="{Binding History}" IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When" Binding="{Binding When}" Width="125"/>
                        <DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="60"/>
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
