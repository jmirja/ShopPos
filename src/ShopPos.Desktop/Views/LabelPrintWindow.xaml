<Window x:Class="ShopPos.Desktop.Views.LabelPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print barcode labels" Width="1100" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" Margin="0,0,16,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Print barcode labels" FontSize="20" FontWeight="SemiBold"/>

                <TextBlock Text="Label size" Margin="0,16,0,4"/>
                <ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}"
                          DisplayMemberPath="Name" Padding="6"/>

                <CheckBox Content="Show price on the label" IsChecked="{Binding ShowPrice}" Margin="0,12,0,0"/>

                <TextBlock Text="Items and number of copies" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                          MaxHeight="260">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="Barcode" Binding="{Binding BarcodeText}" IsReadOnly="True" Width="110"/>
                        <DataGridTextColumn Header="Copies" Binding="{Binding Copies}" Width="60"/>
                        <DataGridTextColumn Header="Problem" Binding="{Binding Problem}" IsReadOnly="True" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Update preview" Command="{Binding PreviewCommand}" Padding="16,8" Margin="0,0,8,0"/>
                    <Button Content="Print..." Command="{Binding PrintCommand}" Padding="28,8"/>
                </StackPanel>

                <TextBlock Text="{Binding Message}" Foreground="#B45309" TextWrapping="Wrap" Margin="0,12,0,0"/>

                <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="12" Margin="0,16,0,0"
                           Text="In the Windows print window choose your label printer, set the paper size to your label size (open Preferences) and the scale to 100%. Print one test label and scan it before printing many."/>
                <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="12" Margin="0,8,0,0"
                           Text="Only EAN-13 / UPC-A barcodes can be printed here. Barcodes from the manufacturer are already on the package and do not need a label."/>
            </StackPanel>
        </ScrollViewer>

        <DocumentViewer Grid.Column="1" Document="{Binding Document, Mode=OneWay}"/>
    </Grid>
</Window>
