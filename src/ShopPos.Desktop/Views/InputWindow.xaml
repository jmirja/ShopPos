<Window x:Class="ShopPos.Desktop.Views.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" FontSize="15"/>
        <TextBox x:Name="InputBox" FontSize="16" Padding="8" Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="22,8" Margin="0,0,8,0"/>
            <Button Content="OK" IsDefault="True" Padding="30,8" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
