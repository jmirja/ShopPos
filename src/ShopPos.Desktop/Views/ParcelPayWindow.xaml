<Window x:Class="ShopPos.Desktop.Views.ParcelPayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#555" Margin="0,4,0,0"/>

        <Border Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="6"
                Padding="12" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Amount, StringFormat=N2}"
                           FontSize="22" FontWeight="Bold" Foreground="#92400E"/>
                <TextBlock Text="Amount" VerticalAlignment="Center" FontSize="15"/>
            </DockPanel>
        </Border>

        <TextBlock Text="Payment method" Margin="0,14,0,4"/>
        <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}"
                  DisplayMemberPath="Name" Padding="6"/>

        <TextBlock Text="Reference (optional, for example a bKash transaction ID)" Margin="0,12,0,4"/>
        <TextBox Padding="6" Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="22,9" Margin="0,0,8,0"/>
            <Button Content="Confirm" IsDefault="True" Padding="26,9" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
