<Window x:Class="ShopPos.Desktop.Views.ReturnGoodsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="1050" Height="720" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"/>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Supplier's credit note number" Margin="0,0,0,4"/>
                <TextBox Text="{Binding CreditNoteNo, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Date" Margin="0,0,0,4"/>
                <DatePicker SelectedDate="{Binding ReturnDate}" Padding="4"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Reason for the return *" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <DockPanel>
                <TextBox DockPanel.Dock="Right" Width="60" Padding="6" Margin="8,0,0,0" ToolTip="Quantity"
                         Text="{Binding ItemQtyText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Padding="6"
                         ToolTip="Type or scan an item (name, SKU, barcode) and press Enter. Scan a phone's IMEI to add that phone."
                         Text="{Binding ItemSearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SubmitItemCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding ItemResults}" MaxHeight="130">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button HorizontalContentAlignment="Stretch" Padding="8,4" Background="White"
                                Command="{Binding DataContext.PickItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" Foreground="#666" FontSize="12"/>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Lines}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                  SelectionMode="Single" Margin="0,12,0,0" RowHeight="34">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Item" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>

                <DataGridTemplateColumn Header="Quantity" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Credit per unit" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding CostText, UpdateSourceTrigger=PropertyChanged}"
                                     HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Batch no" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding BatchNo, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Visibility="{Binding IsBatch, Converter={StaticResource BoolToVis}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="IMEIs" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding SerialButtonText}" Click="Serials_Click" Margin="2"
                                    Visibility="{Binding IsSerial, Converter={StaticResource BoolToVis}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N2}" IsReadOnly="True" Width="100"/>

                <DataGridTemplateColumn Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Remove" Margin="2"
                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding TotalText}" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="{Binding SplitText}" Foreground="#92400E" FontWeight="SemiBold" Margin="0,4,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Refund received now" Margin="0,0,0,4"/>
                        <TextBox Width="130" Padding="6" Text="{Binding RefundText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Refunded with" Margin="0,0,0,4"/>
                        <ComboBox Width="150" Padding="6" ItemsSource="{Binding Methods}"
                                  SelectedItem="{Binding SelectedMethod}" DisplayMemberPath="Name"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Reference" Margin="0,0,0,4"/>
                        <TextBox Width="200" Padding="6" Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                <Button Content="Cancel" IsCancel="True" Padding="22,10" Margin="0,0,8,0"/>
                <Button Content="Save return" IsDefault="True" Padding="26,10" Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
