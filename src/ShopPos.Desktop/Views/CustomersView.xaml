<UserControl x:Class="ShopPos.Desktop.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: list -->
        <DockPanel Grid.Column="0" Margin="0,0,24,0">
            <TextBlock DockPanel.Dock="Top" Text="Customers" FontSize="24" FontWeight="SemiBold"/>
            <Button DockPanel.Dock="Top" Content="+ New customer" Command="{Binding NewCommand}"
                    HorizontalAlignment="Left" Padding="12,6" Margin="0,12,0,8"/>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchCommand}"
                        Padding="10,4" Margin="6,0,0,0"/>
                <TextBox Padding="6" ToolTip="Name, phone or address, then press Enter"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <CheckBox Content="Only customers who owe money" IsChecked="{Binding OwingOnly}" Margin="0,0,16,0"/>
                <CheckBox Content="Show inactive" IsChecked="{Binding ShowInactive}"/>
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Text="{Binding TotalDueText}" Foreground="#B45309"
                       FontWeight="SemiBold" Margin="0,0,0,6"/>

            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                      IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="105"/>
                    <DataGridTextColumn Header="Owes" Binding="{Binding Due, StringFormat=N2}" Width="85">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Last bought" Binding="{Binding LastPurchaseText}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Right: one customer -->
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="{Binding FormTitle}" FontSize="18" FontWeight="SemiBold"/>

            <!-- Money owed -->
            <Border DockPanel.Dock="Top" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1"
                    CornerRadius="8" Padding="14" Margin="0,10,0,10"
                    Visibility="{Binding HasCustomer, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Collect payment..." Click="Collect_Click"
                            Padding="16,8" VerticalAlignment="Center" IsEnabled="{Binding CanCollect}"/>
                    <StackPanel>
                        <TextBlock Text="This customer owes" Foreground="#78350F" FontSize="12"/>
                        <TextBlock Text="{Binding CurrentDue, StringFormat=N2}" FontSize="26" FontWeight="Bold"
                                   Foreground="#92400E"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="#B91C1C"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding InfoMessage}" Foreground="#15803D"
                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>

            <TabControl>
                <TabItem Header="Details">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12" MaxWidth="460" HorizontalAlignment="Left">
                            <TextBlock Text="Name *" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>

                            <TextBlock Text="Phone" Margin="0,12,0,4"/>
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>

                            <TextBlock Text="Address" Margin="0,12,0,4"/>
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>

                            <TextBlock Text="Notes" Margin="0,12,0,4"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Padding="6"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>

                            <TextBlock Text="Old balance (money owed from before you used this app)" Margin="0,12,0,4"/>
                            <TextBox Text="{Binding OpeningDueText, UpdateSourceTrigger=PropertyChanged}" Padding="6"
                                     IsEnabled="{Binding CanEditPrivileged}"/>
                            <TextBlock Text="Only an Owner or Manager can change this." Foreground="#666" FontSize="12"/>

                            <CheckBox Content="Active customer" IsChecked="{Binding IsActive}" Margin="0,12,0,0"
                                      IsEnabled="{Binding CanEditPrivileged}"/>

                            <Button Content="Save customer" Command="{Binding SaveCommand}"
                                    HorizontalAlignment="Left" Padding="28,8" Margin="0,18,0,12"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Purchases">
                    <DataGrid ItemsSource="{Binding Purchases}" IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="125"/>
                            <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNo}" Width="*"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="85"/>
                            <DataGridTextColumn Header="Paid" Binding="{Binding Paid, StringFormat=N2}" Width="85"/>
                            <DataGridTextColumn Header="Due" Binding="{Binding Due, StringFormat=N2}" Width="85"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Payments">
                    <DataGrid ItemsSource="{Binding Payments}" IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="125"/>
                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="100"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding AmountText}" Width="90"/>
                            <DataGridTextColumn Header="Bill" Binding="{Binding Invoice}" Width="110"/>
                            <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</UserControl>
