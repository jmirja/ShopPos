<UserControl x:Class="ShopPos.Desktop.Views.PurchasingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Suppliers and purchases" FontSize="24" FontWeight="SemiBold"/>

        <TabControl Margin="0,12,0,0">

            <!-- ============================ suppliers ============================ -->
            <TabItem Header="Suppliers">
                <Grid Margin="0,12,0,0" DataContext="{Binding Suppliers}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="460"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,24,0">
                        <Button DockPanel.Dock="Top" Content="+ New supplier" Command="{Binding NewCommand}"
                                HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,8"/>

                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchCommand}"
                                    Padding="10,4" Margin="6,0,0,0"/>
                            <TextBox Padding="6" ToolTip="Name, contact person or phone, then press Enter"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>

                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox Content="Only suppliers I owe money" IsChecked="{Binding OwingOnly}" Margin="0,0,16,0"/>
                            <CheckBox Content="Show inactive" IsChecked="{Binding ShowInactive}"/>
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Top" Text="{Binding TotalDueText}" Foreground="#B45309"
                                   FontWeight="SemiBold" Margin="0,0,0,6"/>

                        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Supplier" Binding="{Binding DisplayName}" Width="*"/>
                                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="110"/>
                                <DataGridTextColumn Header="You owe" Binding="{Binding Due, StringFormat=N2}" Width="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding FormTitle}" FontSize="18" FontWeight="SemiBold"/>

                        <Border DockPanel.Dock="Top" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,10,0,10"
                                Visibility="{Binding HasSupplier, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Receive goods..." Click="ReceiveDirect_Click" Padding="14,8" Margin="0,0,8,0"/>
                                    <Button Content="Return goods..." Click="ReturnGoods_Click" Padding="14,8" Margin="0,0,8,0"/>
                                    <Button Content="Pay supplier..." Click="Pay_Click" Padding="14,8"
                                            IsEnabled="{Binding CanPay}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="You owe this supplier" Foreground="#78350F" FontSize="12"/>
                                    <TextBlock Text="{Binding CurrentDue, StringFormat=N2}" FontSize="26" FontWeight="Bold"
                                               Foreground="#92400E"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="#B91C1C"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding InfoMessage}" Foreground="#15803D"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <TabControl>
                            <TabItem Header="Details">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12" MaxWidth="460" HorizontalAlignment="Left">
                                        <TextBlock Text="Supplier name *" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>

                                        <TextBlock Text="Contact person" Margin="0,12,0,4"/>
                                        <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>

                                        <TextBlock Text="Phone" Margin="0,12,0,4"/>
                                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>

                                        <TextBlock Text="Address" Margin="0,12,0,4"/>
                                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Padding="6"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"/>

                                        <TextBlock Text="Old balance (what you already owed before using this app)" Margin="0,12,0,4"/>
                                        <TextBox Text="{Binding OpeningDueText, UpdateSourceTrigger=PropertyChanged}" Padding="6"
                                                 IsEnabled="{Binding CanEditPrivileged}"/>
                                        <TextBlock Text="Only an Owner or Manager can change this." Foreground="#666" FontSize="12"/>

                                        <CheckBox Content="Active supplier" IsChecked="{Binding IsActive}" Margin="0,12,0,0"
                                                  IsEnabled="{Binding CanEditPrivileged}"/>

                                        <Button Content="Save supplier" Command="{Binding SaveCommand}"
                                                HorizontalAlignment="Left" Padding="28,8" Margin="0,18,0,12"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Purchases">
                                <DataGrid ItemsSource="{Binding Purchases}" IsReadOnly="True" AutoGenerateColumns="False"
                                          CanUserAddRows="False" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="100"/>
                                        <DataGridTextColumn Header="Receipt" Binding="{Binding ReceiptNo}" Width="95"/>
                                        <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNo}" Width="*"/>
                                        <DataGridTextColumn Header="Order" Binding="{Binding PoNo}" Width="90"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="85"/>
                                        <DataGridTextColumn Header="Paid" Binding="{Binding Paid, StringFormat=N2}" Width="85"/>
                                        <DataGridTextColumn Header="Due" Binding="{Binding Due, StringFormat=N2}" Width="85"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="Payments">
                                <DataGrid ItemsSource="{Binding Payments}" IsReadOnly="True" AutoGenerateColumns="False"
                                          CanUserAddRows="False" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="125"/>
                                        <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="100"/>
                                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="90"/>
                                        <DataGridTextColumn Header="For receipt" Binding="{Binding ReceiptNo}" Width="100"/>
                                        <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ========================== purchase orders ========================== -->
            <TabItem Header="Purchase orders">
                <Grid Margin="0,12,0,0" DataContext="{Binding Orders}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- list -->
                    <DockPanel Grid.Column="0" Margin="0,0,24,0">
                        <Button DockPanel.Dock="Top" Content="+ New purchase order" Command="{Binding NewOrderCommand}"
                                HorizontalAlignment="Left" Padding="12,6" Margin="0,0,0,8"/>
                        <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                                  DisplayMemberPath="Label" Padding="6" Margin="0,0,0,6"/>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchCommand}"
                                    Padding="10,4" Margin="6,0,0,0"/>
                            <TextBox Padding="6" ToolTip="Order number or supplier, then press Enter"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>

                        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Order" Binding="{Binding PoNo}" Width="85"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="95"/>
                                <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="80"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- the order -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding OrderTitle}" FontSize="18" FontWeight="SemiBold"/>

                            <StackPanel IsEnabled="{Binding CanEdit}">
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="170"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Supplier *" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding SupplierOptions}" SelectedItem="{Binding SelectedSupplier}"
                                                  DisplayMemberPath="Name" Padding="6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Order date" Margin="0,0,0,4"/>
                                        <DatePicker SelectedDate="{Binding OrderDate}" Padding="4"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Notes" Margin="0,10,0,4"/>
                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>

                                <TextBlock Text="Add an item" FontWeight="SemiBold" Margin="0,14,0,4"/>
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Right" Width="60" Padding="6" Margin="8,0,0,0" ToolTip="Quantity"
                                             Text="{Binding ItemQtyText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Padding="6" ToolTip="Type or scan an item (name, SKU or barcode) and press Enter"
                                             Text="{Binding ItemSearchText, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SubmitItemCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding ItemResults}" MaxHeight="130">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button HorizontalContentAlignment="Stretch" Padding="8,4" Background="White"
                                                    Command="{Binding DataContext.PickItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" Foreground="#666" FontSize="12"/>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False"
                                      CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single"
                                      MaxHeight="260" Margin="0,8,0,0" RowHeight="34">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Item" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                                    <DataGridTemplateColumn Header="Qty" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}"
                                                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Unit cost" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding CostText, UpdateSourceTrigger=PropertyChanged}"
                                                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Arrived" Binding="{Binding QtyReceived, StringFormat=0.###}"
                                                        IsReadOnly="True" Width="65"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N2}"
                                                        IsReadOnly="True" Width="90"/>
                                    <DataGridTemplateColumn Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Remove" Margin="2"
                                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="{Binding TotalText}" FontSize="16" FontWeight="Bold" Margin="0,8,0,0"/>

                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding InfoMessage}" Foreground="#15803D" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>

                            <WrapPanel Margin="0,10,0,24">
                                <Button Content="Save draft" Command="{Binding SaveCommand}" Padding="14,7"
                                        Margin="0,0,8,8" IsEnabled="{Binding CanEdit}"/>
                                <Button Content="Mark as ordered" Command="{Binding MarkOrderedCommand}" Padding="14,7"
                                        Margin="0,0,8,8" IsEnabled="{Binding CanEdit}"/>
                                <Button Content="Receive goods..." Click="ReceiveFromPo_Click" Padding="14,7"
                                        Margin="0,0,8,8" IsEnabled="{Binding CanReceive}" FontWeight="SemiBold"/>
                                <Button Content="Cancel order..." Click="CancelOrder_Click" Padding="14,7"
                                        Margin="0,0,8,8" IsEnabled="{Binding CanCancel}"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
