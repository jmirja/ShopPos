<Window x:Class="ShopPos.Desktop.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shop POS - First-time setup" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="32">
        <TextBlock Text="Welcome! Create the owner account" FontSize="22"
                   FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="This is the main administrator account for your shop. You can add cashiers later."
                   Foreground="#555" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <TextBlock Text="Full name" Margin="0,18,0,4"/>
        <TextBox x:Name="FullNameBox" Padding="6"
                 Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Username" Margin="0,12,0,4"/>
        <TextBox Padding="6" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Password (at least 8 characters)" Margin="0,12,0,4"/>
        <PasswordBox x:Name="PasswordInput" Padding="6"/>

        <TextBlock Text="Confirm password" Margin="0,12,0,4"/>
        <PasswordBox x:Name="ConfirmInput" Padding="6"/>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C"
                   TextWrapping="Wrap" Margin="0,12,0,0"/>

        <Button x:Name="CreateButton" Content="Create account" IsDefault="True"
                Margin="0,18,0,0" Padding="0,8" Click="CreateButton_Click"/>
    </StackPanel>
</Window>
