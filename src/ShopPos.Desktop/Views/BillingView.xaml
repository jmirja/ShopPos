<UserControl x:Class="ShopPos.Desktop.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- Left: search, matches, cart -->
        <DockPanel Grid.Column="0" Margin="0,0,24,0">
            <TextBlock DockPanel.Dock="Top" Text="Billing" FontSize="24" FontWeight="SemiBold"/>

            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" FontSize="20" Padding="10" Margin="0,12,0,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SubmitCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <TextBlock DockPanel.Dock="Top" Foreground="#666" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Scan a barcode or IMEI, or type a name, SKU or the last digits of an IMEI, then press Enter.   F2 = back to this box.   Delete = remove the selected line."/>

            <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="#B91C1C"
                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding InfoMessage}" Foreground="#1D4ED8"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>

            <!-- Matches while typing -->
            <Border DockPanel.Dock="Top" BorderBrush="#D1D5DB" BorderThickness="1" Margin="0,8,0,0" MaxHeight="240"
                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button HorizontalContentAlignment="Stretch" Padding="10,6" BorderThickness="0,0,0,1"
                                        Background="White"
                                        Command="{Binding DataContext.PickResultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PriceText}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="#666" FontSize="12"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- The bill -->
            <DataGrid ItemsSource="{Binding Cart}" SelectedItem="{Binding SelectedLine}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" SelectionMode="Single" FontSize="15" RowHeight="36"
                      Margin="0,12,0,0">
                <DataGrid.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding RemoveLineCommand}"/>
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Item" Binding="{Binding DisplayText}" IsReadOnly="True" Width="*"/>

                    <DataGridTemplateColumn Header="Price" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding UnitPrice, StringFormat=N2}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                               Visibility="{Binding PriceReadOnly, Converter={StaticResource BoolToVis}}"/>
                                    <TextBox Text="{Binding UnitPrice, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                                             HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                             Visibility="{Binding PriceEditable, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Qty" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Qty, StringFormat=0.###}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Margin="0,0,8,0"
                                               Visibility="{Binding QtyReadOnly, Converter={StaticResource BoolToVis}}"/>
                                    <TextBox Text="{Binding Qty, StringFormat=0.###, UpdateSourceTrigger=LostFocus}"
                                             HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                                             Visibility="{Binding QtyEditable, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat=N2}"
                                        IsReadOnly="True" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Remove" Margin="2"
                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Right: totals -->
        <Border Grid.Column="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                CornerRadius="8" Padding="20" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="This bill" FontSize="18" FontWeight="SemiBold"/>

                <DockPanel Margin="0,16,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount, StringFormat=0.###}"/>
                    <TextBlock Text="Items"/>
                </DockPanel>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Subtotal, StringFormat=N2}"/>
                    <TextBlock Text="Subtotal"/>
                </DockPanel>

                <Separator Margin="0,14"/>

                <TextBlock Text="Total" FontSize="14" Foreground="#666"/>
                <TextBlock Text="{Binding Total, StringFormat=N2}" FontSize="36" FontWeight="Bold"/>

                <Button Content="Pay (coming in the next step)" IsEnabled="False" Padding="0,12" Margin="0,20,0,0"/>
                <Button Content="Clear bill" Click="ClearBill_Click" Padding="0,8" Margin="0,8,0,0"
                        IsEnabled="{Binding HasItems}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
